{
 "sura": 101,
 "ayat": [
  {
   "loc": "101:1",
   "ar": "ٱلْقَارِعَةُ",
   "translation": {
    "text": "Hari Kiamat.",
    "footnotes": []
   }
  },
  {
   "loc": "101:3",
   "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
   "translation": {
    "text": "Dan tahukah kamu apakah hari Kiamat itu?",
    "footnotes": []
   }
  },
  {
   "loc": "101:4",
   "ar": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
   "translation": {
    "text": "Pada hari itu manusia seperti laron yang beterbangan,",
    "footnotes": []
   }
  },
  {
   "loc": "101:5",
   "ar": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
   "translation": {
    "text": "dan gunung-gunung seperti bulu yang dihambur-hamburkan.",
    "footnotes": []
   }
  },
  {
   "loc": "101:6",
   "ar": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
   "translation": {
    "text": "Maka adapun orang yang berat timbangan (kebaikan)nya,",
    "footnotes": []
   }
  },
  {
   "loc": "101:7",
   "ar": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
   "translation": {
    "text": "maka dia berada dalam kehidupan yang memuaskan (senang).",
    "footnotes": []
   }
  },
  {
   "loc": "101:8",
   "ar": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
   "translation": {
    "text": "Dan adapun orang yang ringan timbangan (kebaikan)nya,",
    "footnotes": []
   }
  },
  {
   "loc": "101:9",
   "ar": "فَأُمُّهُۥ هَاوِيَةٌ",
   "translation": {
    "text": "maka tempat kembalinya adalah neraka Hāwiyah.",
    "footnotes": []
   }
  },
  {
   "loc": "101:11",
   "ar": "نَارٌ حَامِيَةٌۢ",
   "translation": {
    "text": "(Yaitu) api yang sangat panas.",
    "footnotes": []
   }
  }
 ]
}
