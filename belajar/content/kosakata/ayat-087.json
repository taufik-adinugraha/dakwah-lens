{
 "sura": 87,
 "ayat": [
  {
   "loc": "87:1",
   "ar": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
   "translation": {
    "text": "Sucikanlah nama Tuhanmu Yang Mahatinggi,",
    "footnotes": []
   }
  },
  {
   "loc": "87:2",
   "ar": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
   "translation": {
    "text": "yang menciptakan, lalu menyempurnakan (penciptaan-Nya),",
    "footnotes": []
   }
  },
  {
   "loc": "87:4",
   "ar": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
   "translation": {
    "text": "dan Yang menumbuhkan rerumputan,",
    "footnotes": []
   }
  },
  {
   "loc": "87:5",
   "ar": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
   "translation": {
    "text": "lalu dijadikan-Nya (rumput-rumput) itu kering kehitam-hitaman.",
    "footnotes": []
   }
  },
  {
   "loc": "87:6",
   "ar": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
   "translation": {
    "text": "Kami akan membacakan (Al-Qur`an) kepadamu (Muhammad) sehingga engkau tidak akan lupa,",
    "footnotes": []
   }
  },
  {
   "loc": "87:7",
   "ar": "إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
   "translation": {
    "text": "kecuali jika Allah menghendaki. Sungguh, Dia mengetahui yang terang dan yang tersembunyi.",
    "footnotes": []
   }
  },
  {
   "loc": "87:8",
   "ar": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
   "translation": {
    "text": "Dan Kami akan memudahkan bagimu ke jalan kemudahan (mencapai kebahagian dunia dan akhirat),",
    "footnotes": []
   }
  },
  {
   "loc": "87:11",
   "ar": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
   "translation": {
    "text": "dan orang yang celaka (kafir) akan menjauhinya,",
    "footnotes": []
   }
  },
  {
   "loc": "87:12",
   "ar": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
   "translation": {
    "text": "(yaitu) orang yang akan memasuki api yang besar (neraka),",
    "footnotes": []
   }
  },
  {
   "loc": "87:14",
   "ar": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
   "translation": {
    "text": "Sungguh beruntung orang yang menyucikan diri (dengan beriman),",
    "footnotes": []
   }
  },
  {
   "loc": "87:15",
   "ar": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
   "translation": {
    "text": "dan mengingat nama Tuhannya, lalu dia salat.",
    "footnotes": []
   }
  },
  {
   "loc": "87:17",
   "ar": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
   "translation": {
    "text": "padahal kehidupan akhirat itu lebih baik dan lebih kekal.",
    "footnotes": []
   }
  },
  {
   "loc": "87:19",
   "ar": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
   "translation": {
    "text": "(yaitu) kitab-kitab Ibrahim dan Musa.",
    "footnotes": []
   }
  }
 ]
}
