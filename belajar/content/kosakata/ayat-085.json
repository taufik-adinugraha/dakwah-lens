{
 "sura": 85,
 "ayat": [
  {
   "loc": "85:1",
   "ar": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
   "translation": {
    "text": "Demi langit yang mempunyai gugusan bintang,",
    "footnotes": []
   }
  },
  {
   "loc": "85:2",
   "ar": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
   "translation": {
    "text": "dan demi hari yang dijanjikan.",
    "footnotes": []
   }
  },
  {
   "loc": "85:3",
   "ar": "وَشَاهِدٍ وَمَشْهُودٍ",
   "translation": {
    "text": "Demi yang menyaksikan dan yang disaksikan.",
    "footnotes": []
   }
  },
  {
   "loc": "85:4",
   "ar": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ",
   "translation": {
    "text": "Binasalah orang-orang yang membuat parit (yaitu para pembesar Najran di Yaman),",
    "footnotes": []
   }
  },
  {
   "loc": "85:6",
   "ar": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
   "translation": {
    "text": "ketika mereka duduk di sekitarnya,",
    "footnotes": []
   }
  },
  {
   "loc": "85:8",
   "ar": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
   "translation": {
    "text": "Dan mereka menyiksa orang-orang mukmin itu hanya karena (orang-orang mukmin itu) beriman kepada Allah Yang Mahaperkasa, Maha Terpuji,",
    "footnotes": []
   }
  },
  {
   "loc": "85:12",
   "ar": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
   "translation": {
    "text": "Sungguh, azab Tuhanmu sangat keras.",
    "footnotes": []
   }
  },
  {
   "loc": "85:13",
   "ar": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
   "translation": {
    "text": "Sungguh, Dialah yang memulai penciptaan (makhluk) dan yang menghidupkannya (kembali).",
    "footnotes": []
   }
  },
  {
   "loc": "85:14",
   "ar": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
   "translation": {
    "text": "Dan Dialah Yang Maha Pengampun, Maha Pengasih,",
    "footnotes": []
   }
  },
  {
   "loc": "85:15",
   "ar": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
   "translation": {
    "text": "Yang memiliki Arasy, lagi Mahamulia,",
    "footnotes": []
   }
  },
  {
   "loc": "85:16",
   "ar": "فَعَّالٌ لِّمَا يُرِيدُ",
   "translation": {
    "text": "Mahakuasa berbuat apa yang Dia kehendaki.",
    "footnotes": []
   }
  },
  {
   "loc": "85:19",
   "ar": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
   "translation": {
    "text": "Memang orang-orang kafir (selalu) mendustakan,",
    "footnotes": []
   }
  },
  {
   "loc": "85:21",
   "ar": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
   "translation": {
    "text": "Bahkan (yang didustakan itu) ialah Al-Qur`an yang mulia,",
    "footnotes": []
   }
  },
  {
   "loc": "85:22",
   "ar": "فِى لَوْحٍ مَّحْفُوظٍۭ",
   "translation": {
    "text": "yang (tersimpan) dalam (tempat) yang terjaga (Lauḥ Maḥfūẓ).",
    "footnotes": []
   }
  }
 ]
}
