{
 "sura": 81,
 "ayat": [
  {
   "loc": "81:1",
   "ar": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
   "translation": {
    "text": "Apabila matahari digulung,",
    "footnotes": []
   }
  },
  {
   "loc": "81:2",
   "ar": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
   "translation": {
    "text": "dan apabila bintang-bintang berjatuhan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:4",
   "ar": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
   "translation": {
    "text": "dan apabila unta-unta yang bunting ditinggalkan (tidak terurus),",
    "footnotes": []
   }
  },
  {
   "loc": "81:5",
   "ar": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
   "translation": {
    "text": "dan apabila binatang-binatang liar dikumpulkan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:6",
   "ar": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
   "translation": {
    "text": "dan apabila lautan dipanaskan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:7",
   "ar": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
   "translation": {
    "text": "dan apabila roh-roh dipertemukan (dengan tubuh),",
    "footnotes": []
   }
  },
  {
   "loc": "81:8",
   "ar": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
   "translation": {
    "text": "dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
    "footnotes": []
   }
  },
  {
   "loc": "81:9",
   "ar": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
   "translation": {
    "text": "karena dosa apa dia dibunuh?",
    "footnotes": []
   }
  },
  {
   "loc": "81:10",
   "ar": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
   "translation": {
    "text": "Dan apabila lembaran-lembaran (catatan amal) telah dibuka lebar-lebar,",
    "footnotes": []
   }
  },
  {
   "loc": "81:11",
   "ar": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
   "translation": {
    "text": "dan apabila langit dilenyapkan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:12",
   "ar": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
   "translation": {
    "text": "dan apabila neraka Jahim dinyalakan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:13",
   "ar": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
   "translation": {
    "text": "dan apabila surga didekatkan,",
    "footnotes": []
   }
  },
  {
   "loc": "81:14",
   "ar": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
   "translation": {
    "text": "setiap jiwa akan mengetahui apa yang telah dikerjakannya.",
    "footnotes": []
   }
  },
  {
   "loc": "81:15",
   "ar": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
   "translation": {
    "text": "Aku bersumpah demi bintang-bintang,",
    "footnotes": []
   }
  },
  {
   "loc": "81:16",
   "ar": "ٱلْجَوَارِ ٱلْكُنَّسِ",
   "translation": {
    "text": "yang beredar dan terbenam,",
    "footnotes": []
   }
  },
  {
   "loc": "81:17",
   "ar": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
   "translation": {
    "text": "demi malam apabila telah larut,",
    "footnotes": []
   }
  },
  {
   "loc": "81:18",
   "ar": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
   "translation": {
    "text": "dan demi subuh apabila telah menyinsing,",
    "footnotes": []
   }
  },
  {
   "loc": "81:20",
   "ar": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
   "translation": {
    "text": "yang memiliki kekuatan, memiliki kedudukan tinggi di sisi (Allah) yang memiliki Arasy,",
    "footnotes": []
   }
  },
  {
   "loc": "81:21",
   "ar": "مُّطَاعٍ ثَمَّ أَمِينٍ",
   "translation": {
    "text": "yang di sana (di alam malaikat) ditaati dan dipercaya.",
    "footnotes": []
   }
  },
  {
   "loc": "81:23",
   "ar": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
   "translation": {
    "text": "Dan sungguh, dia (Muhammad) telah melihatnya (Jibril) di ufuk yang terang.",
    "footnotes": []
   }
  },
  {
   "loc": "81:24",
   "ar": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
   "translation": {
    "text": "Dan Dia (Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.",
    "footnotes": []
   }
  },
  {
   "loc": "81:25",
   "ar": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ",
   "translation": {
    "text": "Dan (Al-Qur`an) itu bukanlah perkataan setan yang terkutuk,",
    "footnotes": []
   }
  },
  {
   "loc": "81:26",
   "ar": "فَأَيْنَ تَذْهَبُونَ",
   "translation": {
    "text": "maka ke manakah kamu akan pergi?[899]",
    "footnotes": [
     "[899] Setelah diterangkan bahwa Al-Qur`an itu benar-benar datang dari Allah, dan di dalamnya ada pelajaran dan petunjuk yang memimpin manusia ke jalan yang lurus, ditanyakanlah kepada orang-orang kafir itu, \"Jalan manakah yang akan kamu tempuh lagi?\""
    ]
   }
  }
 ]
}
