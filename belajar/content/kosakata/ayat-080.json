{
 "sura": 80,
 "ayat": [
  {
   "loc": "80:1",
   "ar": "عَبَسَ وَتَوَلَّىٰٓ",
   "translation": {
    "text": "Dia (Muhammad) berwajah masam dan berpaling,",
    "footnotes": []
   }
  },
  {
   "loc": "80:5",
   "ar": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
   "translation": {
    "text": "Adapun orang yang merasa dirinya serba cukup (pembesar-pembesar Quraisy),",
    "footnotes": []
   }
  },
  {
   "loc": "80:6",
   "ar": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
   "translation": {
    "text": "maka engkau (Muhammad) memberi perhatian kepadanya,",
    "footnotes": []
   }
  },
  {
   "loc": "80:10",
   "ar": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
   "translation": {
    "text": "engkau (Muhammad) malah mengabaikannya.",
    "footnotes": []
   }
  },
  {
   "loc": "80:13",
   "ar": "فِى صُحُفٍ مُّكَرَّمَةٍ",
   "translation": {
    "text": "di dalam kitab-kitab yang dimuliakan (di sisi Allah),",
    "footnotes": []
   }
  },
  {
   "loc": "80:14",
   "ar": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
   "translation": {
    "text": "yang ditinggikan (dan) disucikan,",
    "footnotes": []
   }
  },
  {
   "loc": "80:15",
   "ar": "بِأَيْدِى سَفَرَةٍ",
   "translation": {
    "text": "di tangan para utusan (malaikat),",
    "footnotes": []
   }
  },
  {
   "loc": "80:17",
   "ar": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
   "translation": {
    "text": "Celakalah manusia! Alangkah kufurnya dia!",
    "footnotes": []
   }
  },
  {
   "loc": "80:21",
   "ar": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
   "translation": {
    "text": "kemudian Dia mematikannya lalu menguburkannya,",
    "footnotes": []
   }
  },
  {
   "loc": "80:22",
   "ar": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
   "translation": {
    "text": "kemudian jika Dia menghendaki, Dia membangkitkannya kembali.",
    "footnotes": []
   }
  },
  {
   "loc": "80:25",
   "ar": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
   "translation": {
    "text": "Kamilah yang telah mencurahkan air melimpah (dari langit),",
    "footnotes": []
   }
  },
  {
   "loc": "80:26",
   "ar": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
   "translation": {
    "text": "kemudian Kami belah bumi dengan sebaik-baiknya,",
    "footnotes": []
   }
  },
  {
   "loc": "80:27",
   "ar": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
   "translation": {
    "text": "lalu di sana Kami tumbuhkan biji-bijian,",
    "footnotes": []
   }
  },
  {
   "loc": "80:28",
   "ar": "وَعِنَبًا وَقَضْبًا",
   "translation": {
    "text": "dan anggur dan sayur-sayuran,",
    "footnotes": []
   }
  },
  {
   "loc": "80:29",
   "ar": "وَزَيْتُونًا وَنَخْلًا",
   "translation": {
    "text": "dan zaitun dan pohon kurma,",
    "footnotes": []
   }
  },
  {
   "loc": "80:30",
   "ar": "وَحَدَآئِقَ غُلْبًا",
   "translation": {
    "text": "dan kebun-kebun (yang) rindang,",
    "footnotes": []
   }
  },
  {
   "loc": "80:31",
   "ar": "وَفَٰكِهَةً وَأَبًّا",
   "translation": {
    "text": "dan buah-buahan serta rerumputan.",
    "footnotes": []
   }
  },
  {
   "loc": "80:33",
   "ar": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
   "translation": {
    "text": "Maka apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),",
    "footnotes": []
   }
  },
  {
   "loc": "80:34",
   "ar": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
   "translation": {
    "text": "pada hari itu manusia lari dari saudaranya,",
    "footnotes": []
   }
  },
  {
   "loc": "80:36",
   "ar": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
   "translation": {
    "text": "dan dari istri dan anak-anaknya.",
    "footnotes": []
   }
  },
  {
   "loc": "80:38",
   "ar": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
   "translation": {
    "text": "Pada hari itu ada wajah-wajah yang berseri-seri,",
    "footnotes": []
   }
  },
  {
   "loc": "80:39",
   "ar": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
   "translation": {
    "text": "tertawa dan gembira ria,",
    "footnotes": []
   }
  },
  {
   "loc": "80:40",
   "ar": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
   "translation": {
    "text": "dan pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram),",
    "footnotes": []
   }
  },
  {
   "loc": "80:41",
   "ar": "تَرْهَقُهَا قَتَرَةٌ",
   "translation": {
    "text": "tertutup oleh kegelapan (ditimpa kehinaan dan kesusahan).",
    "footnotes": []
   }
  }
 ]
}
