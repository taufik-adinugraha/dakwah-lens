{
 "sura": 82,
 "ayat": [
  {
   "loc": "82:1",
   "ar": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
   "translation": {
    "text": "Apabila langit terbelah,",
    "footnotes": []
   }
  },
  {
   "loc": "82:2",
   "ar": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
   "translation": {
    "text": "dan apabila bintang-bintang jatuh berserakan,",
    "footnotes": []
   }
  },
  {
   "loc": "82:3",
   "ar": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
   "translation": {
    "text": "dan apabila lautan dijadikan meluap,",
    "footnotes": []
   }
  },
  {
   "loc": "82:4",
   "ar": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
   "translation": {
    "text": "dan apabila kuburan-kuburan dibongkar,",
    "footnotes": []
   }
  },
  {
   "loc": "82:6",
   "ar": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
   "translation": {
    "text": "Wahai manusia! Apakah yang telah memperdayakan kamu (berbuat durhaka) terhadap Tuhanmu Yang Maha Pengasih.",
    "footnotes": []
   }
  },
  {
   "loc": "82:8",
   "ar": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
   "translation": {
    "text": "dalam bentuk apa saja yang dikehendaki, Dia menyusun tubuhmu.",
    "footnotes": []
   }
  },
  {
   "loc": "82:11",
   "ar": "كِرَامًا كَٰتِبِينَ",
   "translation": {
    "text": "yang mulia (di sisi Allah) dan yang mencatat (perbuatanmu),",
    "footnotes": []
   }
  },
  {
   "loc": "82:12",
   "ar": "يَعْلَمُونَ مَا تَفْعَلُونَ",
   "translation": {
    "text": "mereka mengetahui apa yang kamu kerjakan.",
    "footnotes": []
   }
  },
  {
   "loc": "82:14",
   "ar": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
   "translation": {
    "text": "dan sesungguhnya orang-orang yang durhaka benar-benar berada dalam neraka.",
    "footnotes": []
   }
  },
  {
   "loc": "82:16",
   "ar": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
   "translation": {
    "text": "Dan mereka tidak mungkin keluar dari neraka itu.",
    "footnotes": []
   }
  }
 ]
}
