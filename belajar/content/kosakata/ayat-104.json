{
 "sura": 104,
 "ayat": [
  {
   "loc": "104:1",
   "ar": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
   "translation": {
    "text": "Celakalah bagi setiap pengumpat dan pencela,",
    "footnotes": []
   }
  },
  {
   "loc": "104:2",
   "ar": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
   "translation": {
    "text": "yang mengumpulkan harta dan menghitung-hitungnya,[924]",
    "footnotes": [
     "[924] Mengumpulkan dan menghitung-hitung harta yang menyebabkan dia menjadi kikir dan tidak mau menginfakkannya di jalan Allah."
    ]
   }
  },
  {
   "loc": "104:3",
   "ar": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
   "translation": {
    "text": "dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya.",
    "footnotes": []
   }
  },
  {
   "loc": "104:4",
   "ar": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
   "translation": {
    "text": "Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Ḥuṭamah.",
    "footnotes": []
   }
  },
  {
   "loc": "104:5",
   "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
   "translation": {
    "text": "Dan tahukah kamu apakah (neraka) Ḥuṭamah itu?",
    "footnotes": []
   }
  },
  {
   "loc": "104:6",
   "ar": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
   "translation": {
    "text": "(Yaitu) api (azab) Allah yang dinyalakan,",
    "footnotes": []
   }
  },
  {
   "loc": "104:7",
   "ar": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
   "translation": {
    "text": "yang (membakar) sampai ke hati.",
    "footnotes": []
   }
  },
  {
   "loc": "104:8",
   "ar": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
   "translation": {
    "text": "Sungguh, api itu ditutup rapat atas (diri) mereka,",
    "footnotes": []
   }
  },
  {
   "loc": "104:9",
   "ar": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
   "translation": {
    "text": "(sedang mereka itu) diikat pada tiang-tiang yang panjang.",
    "footnotes": []
   }
  }
 ]
}
