{
 "sura": 114,
 "ayat": [
  {
   "loc": "114:1",
   "ar": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
   "translation": {
    "text": "Katakanlah, \"Aku berlindung kepada Tuhannya manusia,",
    "footnotes": []
   }
  },
  {
   "loc": "114:2",
   "ar": "مَلِكِ ٱلنَّاسِ",
   "translation": {
    "text": "Raja manusia,",
    "footnotes": []
   }
  },
  {
   "loc": "114:4",
   "ar": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
   "translation": {
    "text": "dari kejahatan (bisikan) setan yang bersembunyi,",
    "footnotes": []
   }
  },
  {
   "loc": "114:5",
   "ar": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
   "translation": {
    "text": "yang membisikkan (kejahatan) ke dalam dada manusia,",
    "footnotes": []
   }
  },
  {
   "loc": "114:6",
   "ar": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
   "translation": {
    "text": "dari (golongan) jin dan manusia.\"",
    "footnotes": []
   }
  }
 ]
}
